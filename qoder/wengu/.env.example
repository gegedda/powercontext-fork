# —— 温故 WenGu 配置示例（复制为 .env 后按需修改）——
# 数据目录：seekdb 数据、PowerContext 状态、上传文件、向量模型都放在这里
WENGU_DATA_DIR=./data

# 知识库后端：auto（能用 seekdb 就用）/ seekdb / sqlite
WENGU_STORE=seekdb

# 向量模型：auto（有本地 ONNX 模型就用，否则哈希）/ onnx / hash / api
WENGU_EMBEDDER=auto
# 仅 WENGU_EMBEDDER=api 时需要：
# WENGU_EMBED_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# WENGU_EMBED_API_KEY=sk-xxxxxxxx
# WENGU_EMBED_API_MODEL=text-embedding-v3

# PowerContext：默认进程内启动；填 URL 则连接已有 Server
# WENGU_POWERCONTEXT_URL=http://127.0.0.1:8080
WENGU_PC_DB=sqlite
WENGU_SCOPE_TITLE=温故 WenGu · 学习记忆
WENGU_SCOPE_KEY=wengu-default-scope

# 复习与检索
WENGU_DAILY_QUOTA=6
WENGU_HYBRID_TOP_K=8
WENGU_CHUNK_SIZE=360
WENGU_CHUNK_OVERLAP=60
